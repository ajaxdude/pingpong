{
  "name": "pingpong",
  "version": "1.1.0",
  "description": "Automated code review MCP using local LLM (DEPRECATED: Use brainrouter instead - https://github.com/ajaxdude/brainrouter)",
  "main": "dist/mcp.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "npm run clean && tsc && node dist/mcp.js",
    "test": "vitest",
    "test:unit": "vitest tests/unit",
    "test:integration": "vitest tests/integration",
    "watch": "tsc --watch"
  },
  "bin": {
    "pingpong": "./dist/mcp.js"
  },
  "keywords": [
    "mcp",
    "llm",
    "code-review",
    "copilot"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.6.0",
    "express": "^4.18.0",
    "mustache": "^4.2.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
